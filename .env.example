# ─── SabiBot Configuration ────────────────────────────────────────
# Copy to .env and fill in your values.
# Only GROQ_API_KEY, POLYGON_PRIVATE_KEY, and TELEGRAM vars are required.

# ─── LLM Providers ───────────────────────────────────────────────
# PRIMARY: Groq (FREE — 14,400 req/day, Llama 3.3 70B)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# FALLBACK: Anthropic (optional — $20/mo, used for critical trade decisions)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# EMBEDDINGS: OpenAI (optional — ~$0.30/mo for text-embedding-3-small)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# LOCAL: Ollama (optional — free, no API key needed, runs on your machine)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Switch primary LLM provider: groq | anthropic | ollama
LLM_PRIMARY_PROVIDER=groq
# Switch fallback: anthropic | groq | ollama | none
LLM_FALLBACK_PROVIDER=anthropic

# ─── Polymarket / Polygon ────────────────────────────────────────
POLYGON_PRIVATE_KEY=
POLYGON_WALLET_ADDRESS=
POLYGON_RPC_URL=https://polygon-rpc.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
# Chain ID: 137 = Polygon mainnet, 80002 = Amoy testnet
CHAIN_ID=137

# ─── Telegram ────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── News Sources ────────────────────────────────────────────────
# GNews (optional, free tier = 100 req/day)
GNEWS_API_KEY=

# ─── Database ────────────────────────────────────────────────────
# SQLite for dev, PostgreSQL URI for production
DATABASE_URL=sqlite+aiosqlite:///data/sabibot.db

# ─── Risk Management ─────────────────────────────────────────────
MAX_POSITION_SIZE_USD=50.0
MAX_PORTFOLIO_EXPOSURE_USD=500.0
MAX_SINGLE_MARKET_PCT=0.05
MAX_DRAWDOWN_PCT=0.20
KELLY_MULTIPLIER=0.25
MIN_EDGE_THRESHOLD=0.08
MIN_CONFIDENCE=0.6

# ─── Bot Behavior ────────────────────────────────────────────────
# Mode: live | paper | backtest
TRADING_MODE=paper
NEWS_SCAN_INTERVAL_SECONDS=60
MARKET_ANALYSIS_INTERVAL_SECONDS=300
PORTFOLIO_REBALANCE_INTERVAL_SECONDS=3600
LOG_LEVEL=INFO
